# Database
DATABASE_URL=postgresql://iris_user:iris_password@localhost:5432/iris_recognition_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# VeriEye SDK
VERIEYE_SDK_PATH=C:/path/to/verieye/sdk
VERIEYE_LICENSE_PATH=C:/path/to/license/file

# Application
APP_NAME=Iris Recognition API
APP_VERSION=1.0.0
DEBUG=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
